rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // USERS Collection
    match /users/{userId} {
      // Allow read to any authenticated user
      allow read: if isAuthenticated();
      // Allow user to manage their own document or admin access
      allow write: if isAuthenticated() && (request.auth.uid == userId || request.auth.token.email == "admin@codecrafters.ai");
    }

    // INCIDENTS Collection
    match /incidents/{incidentId} {
      // Public read access for disaster intelligence map/feed
      allow read: if true;
      // Authenticated users can create incidents with their own UID
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      // Authenticated operational users can update/delete incidents
      allow update, delete: if isAuthenticated();
    }
  }
}

# DisasterLens AI — Backend Server Environment
# Copy to .env and fill in values

# Server
PORT=4000
NODE_ENV=development

# Firebase Admin SDK
# Option A: Path to service account JSON key file
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option B: Inline credentials (use if no key file)
# FIREBASE_PROJECT_ID=codecrafters-a0f3f
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# Demo mode (set to true for SIH presentation)
DEMO_MODE=false

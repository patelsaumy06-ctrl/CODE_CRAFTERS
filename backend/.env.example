# DisasterLens AI — Backend Server Environment
# Copy to .env and fill in values

# Server
PORT=4000
NODE_ENV=development

# Firebase Admin SDK (REQUIRED for Firestore + Auth token verification)
# Download service account JSON from Firebase Console → Project Settings → Service Accounts
# Option A: Path to service account JSON key file (recommended)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option B: Inline credentials (use if no key file — never commit real values)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# Demo mode (set to true for SIH presentation)
DEMO_MODE=false

# ─── LLM Configuration (optional) ───────────────────────────────
# When disabled, the deterministic keyword classifier is used as fallback.
LLM_ENABLED=false
LLM_PROVIDER=gemini
LLM_MODEL=gemini-pro
LLM_API_KEY=your_llm_api_key_here

# ─── Reddit Integration (optional) ──────────────────────────────
# Create a Reddit "script" application at https://www.reddit.com/prefs/apps
REDDIT_ENABLED=false
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=DisasterLensAI/1.0 (SIH PS-SW-005)
REDDIT_SUBREDDITS=disaster,naturaldisasters,weather,floods,earthquakes
